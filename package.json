{
  "name": "namesales",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "generate:sample": "tsx scripts/generate-sample.ts",
    "db:migrate": "wrangler d1 migrations apply --local",
    "db:sample": "tsx scripts/load-sales.ts --csv fixtures/sample-sales.csv --local --reset",
    "db:load": "tsx scripts/load-sales.ts"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
